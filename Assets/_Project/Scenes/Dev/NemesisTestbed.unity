  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>S2 \xB7 WIR-028 \xB7 TRUSS PILLARS</b>\n<size=62%>Bridges_support_2
    paired like Zona1's crate room; the route runs straight through both pairs.\nPASS:
    it walks AROUND them, never through a truss or through the 1 m gap of a pair.\nThe
    north pair and the south-east pillar carry Zona1's scene NavMeshObstacle: their
    collider is left out of the bake and only the prefab's Not Walkable volume keeps
    them clear.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
