      m_Calls: []
  m_text: "<b>HANG \xB7 3.6 m</b>\n<size=62%>It stops at the edge, looks down and
    growls, turns its back, hangs and lets go, and stays down a moment on landing:
    your window.\nWay back up: the ramp on the west wall. On patrol it takes the
    ramp, not the drop.</size>"
